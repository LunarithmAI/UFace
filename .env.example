# Copy to .env.local and use a Gemini key from a billing-enabled Cloud project.
# Personal photos must not be sent through Google's unpaid services.
# Never prefix this variable with NEXT_PUBLIC_. Missing configuration returns 503.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
ANALYSIS_DAILY_LIMIT=50

# Deploy one Node process behind HTTPS. The proxy must preserve the external
# Host and X-Forwarded-Proto. The global attempt limit resets on process restart;
# it is neither authentication nor a shared multi-replica quota.
# UFACE_SMOKE_PHOTO may designate a permitted adult photo for manual verification.
